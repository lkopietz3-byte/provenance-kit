{
  "name": "provenance-kit",
  "version": "0.3.0",
  "description": "A copy regression gate for banned and retracted wording, plus a lint that checks claim wording is not stronger than its verified, modeled or editorial label. Wording checks, not fact-checkers.",
  "keywords": [
    "provenance",
    "claims",
    "content-integrity",
    "overclaiming",
    "editorial",
    "trust",
    "typescript",
    "zero-dependencies",
    "honesty-kits"
  ],
  "author": "Lucas Kopietz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkopietz3-byte/provenance-kit.git"
  },
  "homepage": "https://lkopietz3-byte.github.io/honesty-kits/#provenance-kit",
  "bugs": {
    "url": "https://github.com/lkopietz3-byte/provenance-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --ignore-scripts --audit-level=low",
    "verify:package": "node scripts/verify-package.mjs",
    "attw": "attw --pack . --ignore-rules cjs-resolves-to-esm",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:package",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
